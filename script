Tabs.AutoFarm:Section({Title = "Settings"})

local AutoFarmCoins = false
local MagnetSpeed = 30 -- Скорость полета к монете
local CollectedCoins = {}
local NoclipConnection = nil

-- 1. Безопасный Noclip и удержание в воздухе
local function EnablePhysics(state)
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if state then
        -- Отключаем коллизию только для деталей персонажа (чтобы проходить сквозь стены)
        if not NoclipConnection then
            NoclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if char and char.Parent and AutoFarmCoins then
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end

        if humanoid then
            humanoid.PlatformStand = true
        end
    else
        -- Отключаем Noclip
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end

        -- Возвращаем устойчивость персонажу
        if humanoid then
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

        -- Включаем коллизию обратно
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end

        -- Приподнимаем персонажа чуть выше, чтобы он не застрял в текстурах пола
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
        end
    end
end

-- 2. Глубокий и точный поиск детали монеты
local function GetClosestCoin()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local myPos = hrp.Position
    local closestCoinPart = nil
    local shortestDistance = math.huge
    
    -- Ищем активный CoinContainer
    local coinContainer = nil
    for _, map in ipairs(workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            coinContainer = container
            break
        end
    end

    if coinContainer then
        for _, coinObj in ipairs(coinContainer:GetChildren()) do
            -- Проверяем, не забанена ли монета локально
            if coinObj and coinObj.Parent and not CollectedCoins[coinObj] then
                local targetPart = nil
                
                if coinObj:IsA("BasePart") then
                    targetPart = coinObj
                else
                    -- Ищем MainCoin внутри CoinVisual или напрямую в модели
                    local coinVisual = coinObj:FindFirstChild("CoinVisual")
                    if coinVisual then
                        targetPart = coinVisual:FindFirstChild("MainCoin") or coinVisual:FindFirstChildWhichIsA("BasePart")
                    end
                    
                    if not targetPart then
                        targetPart = coinObj:FindFirstChild("MainCoin") or coinObj.PrimaryPart or coinObj:FindFirstChildWhichIsA("BasePart", true)
                    end
                end

                -- Проверяем, что деталь видима и не прозрачна (не поднята)
                if targetPart and targetPart:IsA("BasePart") and targetPart.Parent and targetPart.Transparency < 1 then
                    local dist = (myPos - targetPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestCoinPart = targetPart
                    end
                end
            end
        end
    end
    
    return closestCoinPart
end

-- 3. Переключатель WindUI
Tabs.AutoFarm:Toggle({
    Title = "Auto Farm",
    Value = false,
    Callback = function(state)
        AutoFarmCoins = state
        EnablePhysics(state)
        
        if not state then
            table.clear(CollectedCoins)
        end
    end
})

-- 4. Стабильный цикл полета
task.spawn(function()
    while true do
        local dt = task.wait()
        
        if AutoFarmCoins then
            local player = game.Players.LocalPlayer
            local char = player.Character
            
            if char and char.Parent then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    -- Всегда сбрасываем вектор падения, чтобы не проваливаться сквозь карту
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    
                    local targetCoin = GetClosestCoin()
                    
                    if targetCoin and targetCoin.Parent then
                        local targetPos = targetCoin.Position
                        local currentPos = hrp.Position
                        local distance = (targetPos - currentPos).Magnitude
                        
                        if distance <= 2 then
                            -- Долетели: телепортируемся ровно на монету для сбора
                            hrp.CFrame = targetCoin.CFrame
                            
                            -- Заносим деталь и ее родительские модели в черные списки
                            CollectedCoins[targetCoin] = true
                            if targetCoin.Parent then
                                CollectedCoins[targetCoin.Parent] = true
                            end
                            if targetCoin.Parent and targetCoin.Parent.Parent and targetCoin.Parent.Parent ~= workspace then
                                CollectedCoins[targetCoin.Parent.Parent] = true
                            end
                            
                            task.wait(0.03)
                        else
                            -- Перемещаем CFrame по направлению к монете
                            local direction = (targetPos - currentPos).Unit
                            local moveStep = direction * (MagnetSpeed * dt * 10)
                            
                            if moveStep.Magnitude > distance then
                                hrp.CFrame = CFrame.new(targetPos)
                            else
                                hrp.CFrame = CFrame.new(currentPos + moveStep)
                            end
                        end
                    else
                        -- Если монет нет: удерживаем персонажа на текущей позиции CFrame, не давая ему упасть
                        hrp.CFrame = CFrame.new(hrp.Position)
                    end
                end
            end
        end
    end
end)

