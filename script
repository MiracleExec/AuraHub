-- 1. Настройка физики (Полный полет без бега)
local function EnablePhysics(state)
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    if state then
        -- Отключаем коллизию (Noclip)
        if not NoclipConnection then
            NoclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if char and char.Parent then
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end

        -- Переводим в состояние физики
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        -- Создаем или активируем BodyVelocity
        local bodyVel = hrp:FindFirstChild("FarmFlyVel")
        if not bodyVel then
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.Name = "FarmFlyVel"
            bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bodyVel.Velocity = Vector3.zero
            bodyVel.Parent = hrp
        end
    else
        -- Отключаем Noclip
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
        
        -- Удаляем силовой вектор
        local bodyVel = hrp:FindFirstChild("FarmFlyVel")
        if bodyVel then
            bodyVel:Destroy()
        end

        -- Возвращаем физику
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

-- 2. Поиск ближайшей монеты (Прямой доступ к Yacht / Hotel / Factory)
local function GetClosestCoin()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local myPos = hrp.Position
    local closestCoin = nil
    local shortestDistance = math.huge
    
    -- 1. Ищем папку с монетами на активной карте (Yacht, Hotel, Factory и т.д.)
    local coinContainer = nil
    
    for _, map in ipairs(workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            coinContainer = container
            break
        end
    end

    -- 2. Перебираем МОНЕТЫ НАПРЯМУЮ (без GetDescendants)
    if coinContainer then
        for _, obj in ipairs(coinContainer:GetChildren()) do
            if obj and obj.Parent and not CollectedCoins[obj] then
                
                -- Берем физический Part монеты или ее CoinVisual
                local part = obj:IsA("BasePart") and obj 
                    or obj:FindFirstChild("CoinVisual") 
                    or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))

                if part and part:IsA("BasePart") and part.Parent and part.Transparency < 1 then
                    local coinPos = part.Position
                    if coinPos then
                        local dist = (myPos - coinPos).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestCoin = part
                        end
                    end
                end
            end
        end
    end
    
    return closestCoin
end

-- 3. Принудительное касание (Touch Interest)
local function TouchCoin(coinPart)
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not coinPart or not coinPart.Parent then return end

    if firetouchinterest then
        firetouchinterest(hrp, coinPart, 0)
        task.wait(0.02)
        firetouchinterest(hrp, coinPart, 1)
    else
        hrp.CFrame = coinPart.CFrame
    end
end

