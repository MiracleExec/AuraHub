-- 1. Управление физикой и полетом
local function EnablePhysics(state)
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    if state then
        -- Включаем Noclip
        if not NoclipConnection then
            NoclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if char and char.Parent then
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end

        -- Настройка полета через CFrame (самый надежный метод без багов физики)
        local bodyVel = hrp:FindFirstChild("FarmFlyVel")
        if not bodyVel then
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.Name = "FarmFlyVel"
            bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bodyVel.Velocity = Vector3.zero
            bodyVel.Parent = hrp
        end
    else
        -- Отключаем Noclip
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
        
        local bodyVel = hrp:FindFirstChild("FarmFlyVel")
        if bodyVel then
            bodyVel:Destroy()
        end
        
        -- Восстанавливаем коллизию персонажа
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

-- 2. Точный поиск ближайшей монеты на любой карте
local function GetClosestCoin()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local myPos = hrp.Position
    local closestCoin = nil
    local shortestDistance = math.huge
    
    -- Ищем активный CoinContainer
    local coinContainer = nil
    for _, map in ipairs(workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            coinContainer = container
            break
        end
    end

    if coinContainer then
        for _, obj in ipairs(coinContainer:GetChildren()) do
            -- Проверяем, что объект существует и не находится в локальном черном списке
            if obj and obj.Parent and not CollectedCoins[obj] then
                
                -- Ищем точную деталь MainCoin
                local part = nil
                if obj:IsA("BasePart") then
                    part = obj
                else
                    local coinVisual = obj:FindFirstChild("CoinVisual")
                    if coinVisual then
                        part = coinVisual:FindFirstChild("MainCoin") or coinVisual:FindFirstChildWhichIsA("BasePart")
                    else
                        part = obj:FindFirstChild("MainCoin") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                    end
                end

                -- Проверка валидности монеты
                if part and part:IsA("BasePart") and part.Parent and part.Transparency < 1 then
                    local dist = (myPos - part.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestCoin = part
                    end
                end
            end
        end
    end
    
    return closestCoin
end

-- 3. Переключатель WindUI
Tabs.AutoFarm:Toggle({
    Title = "Auto Farm",
    Value = false,
    Callback = function(state)
        AutoFarmCoins = state
        EnablePhysics(state)
        
        if not state then
            table.clear(CollectedCoins)
        end
    end
})

-- 4. Главный цикл фарма
task.spawn(function()
    while true do
        task.wait()
        
        if AutoFarmCoins then
            local player = game.Players.LocalPlayer
            local char = player.Character
            
            if char and char.Parent then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChild("Humanoid")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    local targetCoin = GetClosestCoin()
                    
                    if targetCoin and targetCoin.Parent then
                        local targetPos = targetCoin.Position
                        local currentPos = hrp.Position
                        local distance = (targetPos - currentPos).Magnitude
                        
                        -- Если подлетели вплотную к монете
                        if distance <= 1.5 then
                            -- Физическое смещение прямо на монету для сбора
                            hrp.CFrame = targetCoin.CFrame
                            
                            -- Заносим модель монеты в локальный список собранных
                            local topModel = targetCoin:FindFirstAncestorWhichIsA("Model") or targetCoin.Parent
                            if topModel then
                                CollectedCoins[topModel] = true
                            end
                            CollectedCoins[targetCoin] = true
                            
                            task.wait(0.08)
                        else
                            -- Плавный полет к монете
                            local direction = (targetPos - currentPos).Unit
                            local flyVel = hrp:FindFirstChild("FarmFlyVel")
                            if flyVel then
                                flyVel.Velocity = direction * MagnetSpeed
                            end
                        end
                    else
                        -- Останавливаемся, если монет на карте больше нет
                        local flyVel = hrp:FindFirstChild("FarmFlyVel")
                        if flyVel then
                            flyVel.Velocity = Vector3.zero
                        end
                    end
                end
            end
        end
    end
end)

