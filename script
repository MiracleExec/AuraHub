-- 1. Полный контроль физики: заморозка падения + Noclip
local function SetPhysicsState(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if enabled then
        -- Отключаем коллизию персонажа на каждом кадре
        if not SteppedConnection then
            SteppedConnection = RunService.Stepped:Connect(function()
                if char and char.Parent and AutoFarmCoins then
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end

        -- Убираем физическое падение (Anchored) или нулевой вектор
        if not HeartbeatConnection then
            HeartbeatConnection = RunService.Heartbeat:Connect(function()
                if char and char.Parent and AutoFarmCoins and hrp then
                    -- Полностью гасим любую кинетическую скорость падения
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end

        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Flying)
        end
    else
        -- Отключаем соединения
        if SteppedConnection then
            SteppedConnection:Disconnect()
            SteppedConnection = nil
        end
        if HeartbeatConnection then
            HeartbeatConnection:Disconnect()
            HeartbeatConnection = nil
        end

        -- Возвращаем физику в норму
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end

        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
end

-- 2. Поиск ближайшей монеты
local function GetClosestCoin()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local myPos = hrp.Position
    local closestCoinPart = nil
    local shortestDistance = math.huge
    
    local coinContainer = nil
    for _, map in ipairs(workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            coinContainer = container
            break
        end
    end

    if coinContainer then
        for _, coinObj in ipairs(coinContainer:GetChildren()) do
            if coinObj and coinObj.Parent and not CollectedCoins[coinObj] then
                local targetPart = nil
                
                if coinObj:IsA("BasePart") then
                    targetPart = coinObj
                else
                    local coinVisual = coinObj:FindFirstChild("CoinVisual")
                    if coinVisual then
                        targetPart = coinVisual:FindFirstChild("MainCoin") or coinVisual:FindFirstChildWhichIsA("BasePart")
                    end
                    if not targetPart then
                        targetPart = coinObj:FindFirstChild("MainCoin") or coinObj.PrimaryPart or coinObj:FindFirstChildWhichIsA("BasePart", true)
                    end
                end

                if targetPart and targetPart:IsA("BasePart") and targetPart.Parent and targetPart.Transparency < 1 then
                    local dist = (myPos - targetPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestCoinPart = targetPart
                    end
                end
            end
        end
    end
    
    return closestCoinPart
end

-- 3. Переключатель
Tabs.AutoFarm:Toggle({
    Title = "Auto Farm",
    Value = false,
    Callback = function(state)
        AutoFarmCoins = state
        SetPhysicsState(state)
        
        if not state then
            table.clear(CollectedCoins)
        end
    end
})

-- 4. Главный цикл движения
task.spawn(function()
    while true do
        local dt = RunService.RenderStepped:Wait()
        
        if AutoFarmCoins then
            local char = LocalPlayer.Character
            if char and char.Parent then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    local targetCoin = GetClosestCoin()
                    
                    if targetCoin and targetCoin.Parent then
                        local targetPos = targetCoin.Position
                        local currentPos = hrp.Position
                        local distance = (targetPos - currentPos).Magnitude
                        
                        if distance <= 2.5 then
                            -- Телепорт прямо на монету
                            hrp.CFrame = targetCoin.CFrame
                            
                            CollectedCoins[targetCoin] = true
                            if targetCoin.Parent then
                                CollectedCoins[targetCoin.Parent] = true
                            end
                            task.wait(0.02)
                        else
                            -- Плавный перелет к монете без использования физики движка
                            local direction = (targetPos - currentPos).Unit
                            local moveDistance = math.min(distance, MagnetSpeed * dt * 10)
                            
                            hrp.CFrame = CFrame.new(currentPos + (direction * moveDistance))
                        end
                    end
                end
            end
        end
    end
end)

