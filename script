        EnablePhysics(state)
        
        if not state then
            table.clear(CollectedCoins)
        end
    end
})

-- 5. Основной цикл полета
task.spawn(function()
    while true do
        task.wait()
        
        if AutoFarmCoins then
            local player = game.Players.LocalPlayer
            local char = player.Character
            
            if char and char.Parent then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChild("Humanoid")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    local targetCoin = GetClosestCoin()
                    
                    if targetCoin and targetCoin.Parent then
                        local targetPos = targetCoin.Position
                        local currentPos = hrp.Position
                        
                        -- Проверка обоих векторов перед математикой
                        if targetPos and currentPos then
                            local distance = (targetPos - currentPos).Magnitude
                            
                            if distance <= 3.5 then
                                TouchCoin(targetCoin)
                                
                                CollectedCoins[targetCoin] = true
                                if targetCoin.Parent then
                                    CollectedCoins[targetCoin.Parent] = true
                                end
                                
                                task.wait(0.05)
                            else
                                -- Направление полета без вылета в nil
                                local direction = (targetPos - currentPos)
                                if direction.Magnitude > 0 then
                                    local flyVel = hrp:FindFirstChild("FarmFlyVel")
                                    if flyVel then
                                        flyVel.Velocity = direction.Unit * MagnetSpeed
                                    end
                                end
                            end
                        end
                    else
                        -- Замираем в воздухе, если монет нет
                        local flyVel = hrp:FindFirstChild("FarmFlyVel")
                        if flyVel then
                            flyVel.Velocity = Vector3.zero
                        end
                    end
                end
            end
        end
    end
end)

